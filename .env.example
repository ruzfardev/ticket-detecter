# ---- App ----
MODE=dev
LOG_LEVEL=INFO

# ---- Postgres ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ticketbot
POSTGRES_USER=ticketbot
POSTGRES_PASSWORD=dev

# ---- Telegram ----
# Get from @BotFather
BOT_TOKEN=1234567890:AAExxx-replace-me
# Random secret for setWebhook secret_token (e.g., openssl rand -hex 16)
WEBHOOK_SECRET=replace-me-with-random-hex
# Public HTTPS URL Telegram posts to (only required in prod / when using webhook)
WEBHOOK_URL=

# ---- Internal auth (bot <-> backend, signed JWT) ----
# openssl rand -hex 32
INTERNAL_JWT_SECRET=replace-me-with-random-32-bytes

# ---- Railway.uz credentials encryption ----
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
RAILWAY_CRED_KEY=

# ---- Railway.uz hisobi (initial seed, after that DB is source of truth) ----
RAILWAY_USERNAME=your_email@example.com
RAILWAY_PASSWORD=

# ---- Worker tuning (defaults are fine for dev) ----
WATCHER_TICK_SECONDS=10
WATCHER_PREMIUM_INTERVAL_S=10
WATCHER_FREE_INTERVAL_S=30
WATCHER_DEDUP_MINUTES=30
WATCHER_RATE_PER_SECOND=2.0

# ---- Admin alerts (your TG chat id; leave empty to disable) ----
ADMIN_CHAT_ID=
# Comma-separated TG user ids with admin rights (/stats, /refund, /broadcast
# and payment notifications). Find your id via @userinfobot. e.g. 970956519
ADMIN_IDS=

# ---- Sentry (optional) ----
SENTRY_DSN=
